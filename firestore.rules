rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. HOTELS & ACCOMMODATIONS
    // Anyone (including anonymous & mobile app guests) can read published accommodations.
    // Writes (create/update/delete) require authentication or admin SDK.
    // =========================================================================
    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================================================================
    // 2. ROOM TYPES & INVENTORY
    // Publicly readable so customers can browse room types, pricing, and amenities.
    // =========================================================================
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================================================================
    // 3. PLATFORM SETTINGS
    // Publicly readable so the app can display dynamic banners, platform fees, and cities.
    // =========================================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================================================================
    // 4. REVIEWS
    // Publicly readable; authenticated users can write reviews.
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // =========================================================================
    // 5. BOOKINGS
    // Customers can only read and write their own bookings.
    // =========================================================================
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    // =========================================================================
    // 6. USER PROFILES
    // Authenticated users can manage their own profile.
    // =========================================================================
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }

    // =========================================================================
    // FALLBACK
    // Allow public read for general platform data, require auth for write
    // =========================================================================
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

