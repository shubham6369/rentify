# Firebase Client Configuration (From Firebase Console > Project Settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=find-your-stay-app.firebaseapp.com
